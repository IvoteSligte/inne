// Tests pass-by-reference and copy semantics.

var x = 10
var y = x
x = 20
// Should print 10 (FIXME)
print(y)

func sort(list: ref list<int>, len: int) {
    for i in 1 to len {
        for j in 0 to len - i {
            if list[j] > list[j + 1] {
                var temp = list[j]
                list[j] = list[j + 1]
                list[j + 1] = temp
            }
        }
    }
}

var list = [5, 4, 9, 2, 1, 3, 6, 7, 8]
sort(list, 9)
print(list)
